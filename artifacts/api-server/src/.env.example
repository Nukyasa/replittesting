# API Server Configuration
PORT=3000
NODE_ENV=development

# Database (PGlite local file)
DATABASE_URL=file:./tender_manager.db

# EJN Portal Credentials
EJN_USER=your_ejn_username_here
EJN_PASS=your_ejn_password_here

# JWT Secret (change in production!)
JWT_SECRET=change-this-secret-in-production-minimum-32-chars

# Anthropic AI API Key for tender analysis
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Slack Webhook URL (optional)
SLACK_WEBHOOK_URL=

# Scraping Settings
SCRAPER_MAX_RETRIES=3
SCRAPER_REQUEST_TIMEOUT_MS=30000
